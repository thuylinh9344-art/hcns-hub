rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Rule hiện có của dự án linh-hr =====
    // Nếu vẫn cần giữ dữ liệu web quản trị cũ, GIỮ NGUYÊN các khối match đang có ở đây
    // và chỉ dán thêm khối "Bàn điều hành HCNS" bên dưới.

    // ===== Bàn điều hành HCNS =====
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Quản trị: xem và sửa toàn bộ. Thêm email quản trị khác (nếu có), cách nhau bằng dấu phẩy.
    function hubAdmin() {
      return signedIn() && request.auth.token.email in [
        'thuylinh9344@gmail.com'
      ];
    }
    // Nhân viên: được cấp trên web ở mục "OKR cá nhân" → "Tài khoản đăng nhập của nhân viên"
    // (lưu ở hcns_hub/main/members/<email>). Không cần sửa rules khi thêm/bớt nhân viên.
    function memPath() {
      return /databases/$(database)/documents/hcns_hub/main/members/$(request.auth.token.email);
    }
    function hubStaff() { return signedIn() && exists(memPath()); }
    function mySid() { return get(memPath()).data.staffId; }

    match /hcns_hub/main/{document=**} {
      allow read, write: if hubAdmin();
    }

    // --- Quyền của nhân viên: chỉ dữ liệu của chính mình ---
    match /hcns_hub/main/members/{email} {
      allow get: if signedIn() && email == request.auth.token.email;
    }
    match /hcns_hub/main/staff/{sid} {
      allow get: if hubStaff() && sid == mySid();
    }
    match /hcns_hub/main/config/main {
      allow get: if hubStaff();
    }
    match /hcns_hub/main/catalog/{id} {
      allow get: if hubStaff();
    }
    match /hcns_hub/main/okrs/{id} {
      allow read: if hubStaff();
    }
    match /hcns_hub/main/logs/{id} {
      allow read: if hubStaff() && resource.data.staffId == mySid();
    }
    match /hcns_hub/main/tasks/{id} {
      allow read: if hubStaff() && resource.data.owner == mySid();
    }
    match /hcns_hub/main/kadj/{id} {
      allow read: if hubStaff() && resource.data.staffId == mySid();
    }
    match /hcns_hub/main/okrp/{id} {
      allow read: if hubStaff() && resource.data.staffId == mySid();
      // Tự lập OKR: chỉ được để Nháp hoặc Gửi duyệt, không tự duyệt.
      allow create: if hubStaff()
        && request.resource.data.staffId == mySid()
        && id == request.resource.data.quarter + '_' + mySid()
        && request.resource.data.status in ['draft', 'submitted']
        && !('rkLive' in request.resource.data);
      // Sửa/check-in: không đổi chủ, không tự duyệt, không sửa nhận xét duyệt.
      allow update: if hubStaff()
        && resource.data.staffId == mySid()
        && request.resource.data.staffId == mySid()
        && request.resource.data.quarter == resource.data.quarter
        // Số liệu KPI tuyển dụng (rkLive) do web của quản trị tự cập nhật, nhân viên không sửa được.
        && request.resource.data.get('rkLive', null) == resource.data.get('rkLive', null)
        && (request.resource.data.status in ['draft', 'submitted']
            || (request.resource.data.status == resource.data.status
                && request.resource.data.get('review', null) == resource.data.get('review', null)));
    }
  }
}
